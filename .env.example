# 실제 값은 .env에만 넣는다. .env는 Git에 올리지 않는다.
# OpenAI 호환 게이트웨이 (base_url은 보통 /v1 까지)
MODEL_LABEL=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_ID=

# 두 번째 연결 (선택)
MODEL2_LABEL=
MODEL2_BASE_URL=
MODEL2_API_KEY=
MODEL2_ID=

# 사내 인증서 묶음 경로 (선택), 요청 제한 시간(초)
MODEL_CA_BUNDLE=
MODEL_TIMEOUT=30

# 임베딩 모델 (OpenAI 호환 /embeddings). 여러 모델은 쉼표로 구분
EMBED_LABEL=
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODELS=

# Milvus (REST v2). 비워 두면 벡터 DB 화면은 예시 데이터로 열린다
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_DB=default
MILVUS_TIMEOUT=30

# 파싱 (선택)
# 실제 파일에서 확인한 DRM 머리말. 구조 분석의 머리말(stats.header)을 보고 등록한다. 제품 서명은 내장하지 않는다.
# 형식: 제품=ascii:문자열 (앞 4 KiB 안) 또는 제품=hex:0A0B0C (파일 맨 앞). 여러 개는 ; 로 구분
DOCOPS_DRM_SIGNATURES=
# DOCX·XLSX·PPTX를 파싱하기 전 사본에서 기호 글꼴·첨자를 유니코드로 바꾼다(원본은 그대로). 끄려면 0
DOCOPS_OOXML_PREPARE=1

# 한국어·영어 EasyOCR. 모델이 준비된 경우 사용하며, 0으로 끌 수 있습니다.
DOCOPS_OCR=1
# craft_mlt_25k.pth와 korean_g2.pth가 있는 폴더. 비우면 Docling 모델의 EasyOcr 또는 ~/.EasyOCR/model
DOCOPS_OCR_MODELS=
