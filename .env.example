# 실제 값은 .env에만 넣는다. .env는 Git에 올리지 않는다.
# OpenAI 호환 게이트웨이 (base_url은 보통 /v1 까지)
MODEL_LABEL=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_ID=

# 두 번째 연결 (선택)
MODEL2_LABEL=
MODEL2_BASE_URL=
MODEL2_API_KEY=
MODEL2_ID=

# 사내 인증서 묶음 경로 (선택), 요청 제한 시간(초)
MODEL_CA_BUNDLE=
MODEL_TIMEOUT=30

# 임베딩 모델 (OpenAI 호환 /embeddings). 여러 모델은 쉼표로 구분
EMBED_LABEL=
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODELS=

# Milvus (REST v2). 비워 두면 벡터 DB 화면은 예시 데이터로 열린다
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_DB=default
MILVUS_TIMEOUT=30
