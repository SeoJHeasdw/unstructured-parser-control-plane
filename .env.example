# 실제 값은 .env에만 넣는다. .env는 Git에 올리지 않는다.
# 설정 화면(모델 연결)에서 저장한 값은 runtime/settings/connections.json에 두고 이 파일보다 우선한다.
# OpenAI 호환 게이트웨이 (base_url은 보통 /v1 까지)
MODEL_LABEL=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_ID=

# 두 번째 연결 (선택)
MODEL2_LABEL=
MODEL2_BASE_URL=
MODEL2_API_KEY=
MODEL2_ID=

# 사내 인증서 묶음 경로 (선택), 요청 제한 시간(초)
MODEL_CA_BUNDLE=
MODEL_TIMEOUT=30

# 임베딩 모델 (OpenAI 호환 /embeddings). 여러 모델은 쉼표로 구분
EMBED_LABEL=
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODELS=

# Milvus (REST v2). 비워 두면 벡터 DB 화면은 예시 데이터로 열린다
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_DB=default
MILVUS_TIMEOUT=30

# 허용 폴더 (선택). 문서함의 '폴더에서 가져오기'와 작업 도구(docops.py)가 이 폴더 안의 파일만 읽는다.
# 브라우저 파일 첨부가 막힌 PC에서 쓴다. 여러 개는 ; 로 구분. 비우면 프로젝트의 samples 폴더(합성 예시)를 쓴다.
# 예: DOCOPS_AGENT_ROOTS=C:\docs\검증문서
DOCOPS_AGENT_ROOTS=

# PDF 모델(Docling 레이아웃·표, 선택). setup이 huggingface.co에서 받는다.
# huggingface.co가 막힌 PC는 다른 PC에서 만든 모델 ZIP을 setup --models <ZIP 경로> 로 설치한다(README 참고).
# 모델을 다른 폴더에 두려면 지정. 비우면 offline/docling-models → 사용자 폴더의 .cache/docling/models 순서로 찾는다.
DOCOPS_DOCLING_ARTIFACTS=
# 사내 Hugging Face 미러(프록시 저장소)가 있을 때만 주석을 풀고 주소를 넣는다. 빈 값으로 두지 않는다.
# HF_ENDPOINT=https://사내-미러-주소

# 파싱 (선택)
# 실제 파일에서 확인한 DRM 머리말. 구조 분석의 머리말(stats.header)을 보고 등록한다. 제품 서명은 내장하지 않는다.
# 형식: 제품=ascii:문자열 (앞 4 KiB 안) 또는 제품=hex:0A0B0C (파일 맨 앞). 여러 개는 ; 로 구분
DOCOPS_DRM_SIGNATURES=
# DOCX·XLSX·XLSM·PPTX를 파싱하기 전 사본에서 기호 글꼴·첨자를 유니코드로 바꾼다(원본은 그대로). 끄려면 0
DOCOPS_OOXML_PREPARE=1

# 문서 OCR 모델(OpenAI 호환 비전 API). EasyOCR 같은 라이브러리 OCR은 쓰지 않는다(2026-11-24 결정).
# 비우면 스캔·그림 글자는 읽지 않는다. 스캔 PDF는 'OCR 미적용' 경고, 이미지 파일은 'OCR 모델 미연결'로 처리하지 않는다.
OCR_LABEL=
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=
# region: Docling 레이아웃 영역마다 호출(PaddleOCR-VL 등), page: 쪽 전체 한 번(Schift·Unlimited-OCR 등)
OCR_MODE=region
OCR_TEXT_PROMPT=
OCR_TABLE_PROMPT=
OCR_PAGE_PROMPT=
OCR_TIMEOUT=180
OCR_CONCURRENCY=4
